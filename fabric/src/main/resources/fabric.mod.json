{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "license": "${license}",
    "environment": "*",
    "accessWidener": "${mod_id}.accesswidener",
    "entrypoints": {
        "main": [
            "com.im.FurnacologyFabric"
        ],
        "client": [
            "com.im.FurnacologyFabricClient"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "forgeconfigapiport": ">=${forgeconfigapiport_version}",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}